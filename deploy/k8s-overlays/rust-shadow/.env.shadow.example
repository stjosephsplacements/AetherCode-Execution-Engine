# Copy to .env.shadow (gitignored) and fill in.
# AC_DATABASE_URL must use a role with SELECT only on submissions (and schema_version);
# the shadow worker reads submissions and never writes. Create it as in docs/ARCHITECTURE.md.
AC_DATABASE_URL=postgres://aethercode_shadow:CHANGE_ME@postgres-svc:5432/aethercode_exec
AC_REDIS_ADDR=redis-svc:6379
AC_JUDGE_URL=http://go-judge-svc:5050
AC_JUDGE_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET

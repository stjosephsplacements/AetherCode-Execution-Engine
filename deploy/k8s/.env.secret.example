# Copy this file to .env.secret and fill in real values before applying the kustomization.
#
#   cp deploy/k8s/.env.secret.example deploy/k8s/.env.secret
#   # edit .env.secret with real credentials
#   kubectl apply -k deploy/k8s/
#
# .env.secret is listed in .gitignore and must NEVER be committed to VCS.
# Use a secrets manager (HashiCorp Vault, AWS Secrets Manager, External Secrets
# Operator, or Sealed Secrets) in production environments.

AC_DATABASE_URL=postgres://aethercode_app:CHANGE_ME@postgres-svc:5432/aethercode_exec
AC_REDIS_ADDR=redis-svc:6379
AC_JUDGE_URL=http://go-judge-svc:5050
AC_JUDGE_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET
AC_OIDC_ISSUER=https://sso.example.com
AC_OIDC_JWKS_URL=https://sso.example.com/oauth/v2/keys
AC_OIDC_AUDIENCE=aethercode-exec

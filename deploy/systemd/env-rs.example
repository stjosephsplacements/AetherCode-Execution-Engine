# Copy to /etc/aethercode-exec-rs/env (mode 0640, owner root:aethercode-exec).
AC_GATEWAY_ADDR=127.0.0.1:5100
AC_DATABASE_URL=postgres://aethercode:CHANGEME@127.0.0.1:5433/aethercode_exec
AC_REDIS_ADDR=127.0.0.1:6379
# AC_REDIS_PASSWORD=
AC_JUDGE_URL=http://127.0.0.1:5050
AC_JUDGE_TOKEN=CHANGEME

# all | gateway | worker (the --role flag overrides it)
AC_ROLE=all
# Worker concurrency budget; 0 = a quarter of the cores.
AC_WORKERS=64
AC_COMPILE_CACHE_MAX_MB=1024
AC_PREWARM=16
# Prometheus metrics: loopback only, http://127.0.0.1:6060/metrics
AC_DEBUG_PORT=6060
# AC_OTLP_ENDPOINT=http://127.0.0.1:4318
# AC_LANGUAGES_FILE=/etc/aethercode-exec-rs/languages.toml

AC_LOG_LEVEL=info
# json | text | gcp | cloudwatch
AC_LOG_FORMAT=json
AC_JOB_TIMEOUT=90s

# Authentication: all three OIDC values must be filled before starting the service.
AC_AUTH_ENABLED=true
AC_OIDC_ISSUER=https://sso.example.com
AC_OIDC_JWKS_URL=https://sso.example.com/.well-known/jwks.json
AC_OIDC_AUDIENCE=
# Local development only:
# AC_AUTH_ENABLED=false
# AC_ALLOW_UNAUTH=true

AC_RATE_LIMIT_PER_MINUTE=30
AC_RATE_LIMIT_BURST=10
AC_ADMISSION_MAX_QUEUE_DEPTH=10000
AC_SUBMIT_STREAM=ac:submissions:submit
AC_RUN_STREAM=ac:submissions:run
AC_SUBMIT_WEIGHT=3
AC_CORS_ALLOWED_ORIGINS=
# 64 hex chars; required for webhook secrets.
# AC_WEBHOOK_MASTER_KEY=
